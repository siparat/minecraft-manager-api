model App {
    id             Int              @id @default(autoincrement())
    order          Int              @default(0)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    packageName    String           @unique
    status         AppStatus        @default(PLANNED)
    logo           String?
    firebaseFile   String?
    banner         String?
    apk            String?
    bundle         String?
    appScreenshots String[]         @default([])
    translations   AppTranslation[]
    mods           AppMod[]
    issues         AppIssue[]
    sdk            AppSdk?
    ads            AppAd[]
}

model AppMod {
    id             Int @id @default(autoincrement())
    app            App @relation(fields: [appId], references: [id], onDelete: Cascade)
    appId          Int
    mod            Mod @relation(fields: [modId], references: [id], onDelete: Cascade)
    modId          Int
    order          Int @default(0)
    createdAt      DateTime @default(now())
    downloadsCount Int @default(0)

    @@unique([appId, modId])
}

model AppIssue {
    id        Int         @id @default(autoincrement())
    createdAt DateTime    @default(now())
    email     String
    text      String
    status    IssueStatus @default(CREATED)
    app       App         @relation(fields: [appId], references: [id], onDelete: Cascade)
    appId     Int
}

model AppSdk {
    appId              Int     @unique
    app                App     @relation(fields: [appId], references: [id], onDelete: Cascade)
    isAdsEnabled       Boolean @default(true)
    isOpenAdsEnabled   Boolean @default(true)
    isInterAdsEnabled  Boolean @default(true)
    isNativeAdsEnabled Boolean @default(true)
    metricaToken       String?
    appLovinToken      String?
    adMobToken         String?
    delayInter         Int     @default(120)
    skipBeforeFirstInterAdsCount Int @default(0)

    adsNativeType      AdsNativeType @default(NATIVE)
    countNativePreload Int           @default(5)
    adsInverval        Int           @default(3)

    firstOpenCode   String?
    firstInterCode  String?
    firstNativeCode String?
    firstBannerCode String?

    secondOpenCode   String?
    secondInterCode  String?
    secondNativeCode String?
    secondBannerCode String?

    thirdOpenCode   String?
    thirdInterCode  String?
    thirdNativeCode String?
    thirdBannerCode String?

    chanceShowOpenAds   Int @default(100)
    chanceShowInterAds  Int @default(100)
    chanceShowNativeAds Int @default(100)
}

model AppAd {
    id        Int      @id @default(autoincrement())
    app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
    appId     Int
    adId      String
    label     String
    isEnabled Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([appId, adId])
}

model Language {
    id              Int              @id @default(autoincrement())
    code            String           @unique
    nameOriginal    String
    nameRu          String
    translations    AppTranslation[]
    modTranslations ModTranslation[]
}

model AppTranslation {
    id         Int      @id @default(autoincrement())
    app        App      @relation(fields: [appId], references: [id], onDelete: Cascade)
    appId      Int
    language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
    languageId Int
    name       String

    @@unique([appId, languageId])
}

enum AppStatus {
    PLANNED
    IN_PROGRESS
    IN_MODERATION
    IN_CORRECTION
    PUBLISHED
}

enum IssueStatus {
    CREATED
    SOLVED
    DELETED
}

enum AdsNativeType {
    NATIVE
    BANNER
}
